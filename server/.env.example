# ============================================================
# 基于LangChain的智能会议纪要助手系统 - 环境变量配置模板
# 复制此文件为 .env 并填入你的实际值
#   cp server/.env.example server/.env
# ============================================================

# DashScope 百炼平台（必填）
# API Key 获取: https://bailian.console.aliyun.com/ → 右上角头像 → API-KEY管理
DASHSCOPE_API_KEY=sk-your-api-key-here
# 工作空间ID 获取: 百炼控制台 → 业务空间
DASHSCOPE_WORKSPACE_ID=ws-your-workspace-id-here

# LLM 模型（可选，默认如下）
# LLM_MODEL=qwen3.6-plus
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSION=2048
# ASR_MODEL=paraformer-v2

# MySQL 数据库（可选，默认如下）
# DB_HOST=localhost
# DB_PORT=3308
# DB_USER=root
# DB_PASSWORD=123456
# DB_NAME=meeting_assistant

# JWT 认证（生产环境请务必修改）
# JWT_SECRET=your-random-secret-string
# JWT_EXPIRE_HOURS=24

# 文件上传（可选）
# UPLOAD_DIR=uploads/
# MAX_UPLOAD_SIZE=6442450944

# 服务配置（可选）
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
